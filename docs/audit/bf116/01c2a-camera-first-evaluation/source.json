        "void UAlsCameraComponent::InitAnim(const bool bForceReinitialize)",
        "{",
        "\tSuper::InitAnim(bForceReinitialize);",
        "",
        "\tAnimationInstance = GetAnimInstance();",
        "}",
        "",
        "void UAlsCameraComponent::BeginPlay()",
        "{",
        "\tALS_ENSURE(IsValid(GetAnimInstance()));",
        "\tALS_ENSURE(IsValid(Settings));",
        "\tALS_ENSURE(IsValid(Character));",
        "",
        "\tSuper::BeginPlay();",
        "}"
      ]
