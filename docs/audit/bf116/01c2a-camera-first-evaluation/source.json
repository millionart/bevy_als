    {
      "source": "Source/ALSCamera/Private/AlsCameraAnimationInstance.cpp",
      "sha256": "1eca38f8a66665c22c7969c68b78a47625730589afbfa92b07f7a08f43c8ef46",
      "first_line": 9,
      "last_line": 65,
      "excerpt": [
        "void UAlsCameraAnimationInstance::NativeInitializeAnimation()",
        "{",
        "\tSuper::NativeInitializeAnimation();",
        "",
        "\tCharacter = Cast<AAlsCharacter>(GetOwningActor());",
        "\tCamera = Cast<UAlsCameraComponent>(GetSkelMeshComponent());",
        "",
        "#if WITH_EDITOR",
        "\tconst auto* World{GetWorld()};",
        "",
        "\tif (IsValid(World) && !World->IsGameWorld())",
        "\t{",
        "\t\t// Use default objects for editor preview.",
        "",
        "\t\tif (!IsValid(Character))",
        "\t\t{",
        "\t\t\tCharacter = GetMutableDefault<AAlsCharacter>();",
        "\t\t}",
        "",
        "\t\tif (!IsValid(Camera))",
        "\t\t{",
        "\t\t\tCamera = GetMutableDefault<UAlsCameraComponent>();",
        "\t\t}",
        "\t}",
        "#endif",
        "}",
        "",
        "void UAlsCameraAnimationInstance::NativeUpdateAnimation(const float DeltaTime)",
        "{",
        "\tSuper::NativeUpdateAnimation(DeltaTime);",
        "",
        "\tif (!IsValid(Character) || !IsValid(Camera))",
        "\t{",
        "\t\treturn;",
        "\t}",
        "",
        "\tViewMode = Character->GetViewMode();",
        "\tLocomotionMode = Character->GetLocomotionMode();",
        "",
        "\tif (ViewMode != AlsViewModeTags::FirstPerson)",
        "\t{",
        "\t\tRotationMode = Character->GetRotationMode();",
        "\t}",
        "\telse",
        "\t{",
        "\t\t// In first-person mode, the rotation mode is always view direction, which can lead to weird camera movement when switching between",
        "\t\t// the first-person view mode and the velocity direction rotation mode, so to fix this we use the desired rotation mode here.",
        "",
        "\t\tRotationMode = Character->GetDesiredRotationMode();",
        "\t}",
        "",
        "\tStance = Character->GetStance();",
        "\tGait = Character->GetGait();",
        "\tLocomotionAction = Character->GetLocomotionAction();",
        "",
        "\tbRightShoulder = Camera->IsRightShoulder();",
        "}"
      ]
    }
