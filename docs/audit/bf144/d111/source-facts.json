      "path": "Engine/Source/Runtime/Core/Private/Math/UnrealMath.cpp",
      "sha256": "0e0bfe3cb82a6f322f45d159ab97ea37666d4e0744861372d5885a652dd4a6e6",
      "anchors": [
        {
          "line": 691,
          "source": "FRotator3d FQuat4d::Rotator() const"
        },
        {
          "line": 694,
          "source": "const double SingularityTest = Z * X - W * Y;"
        },
        {
          "line": 695,
          "source": "const double YawY = 2.0 * (W * Z + X * Y);"
        },
        {
          "line": 696,
          "source": "const double YawX = (1.0 - 2.0 * (FMath::Square(Y) + FMath::Square(Z)));"
        },
        {
          "line": 698,
          "source": "const double SINGULARITY_THRESHOLD = 0.4999995;"
        },
        {
          "line": 702,
          "source": "if (SingularityTest < -SINGULARITY_THRESHOLD)"
        },
        {
          "line": 705,
          "source": "Yaw = FRotator3d::NormalizeAxis(-2.0 * FMath::Atan2(X, W) * RAD_TO_DEG);"
        },
        {
          "line": 706,
          "source": "Roll = 0.0;"
        },
        {
          "line": 708,
          "source": "else if (SingularityTest > SINGULARITY_THRESHOLD)"
        },
        {
          "line": 711,
          "source": "Yaw = FRotator3d::NormalizeAxis(2.0 * FMath::Atan2(X, W) * RAD_TO_DEG);"
        },
        {
          "line": 712,
          "source": "Roll = 0.0;"
        },
        {
          "line": 717,
          "source": "Yaw = (FMath::Atan2(YawY, YawX) * RAD_TO_DEG);"
        },
        {
          "line": 718,
          "source": "Roll = (FMath::Atan2(-2.0 * (W * X + Y * Z), (1.0 - 2.0 * (FMath::Square(X) + FMath::Square(Y)))) * RAD_TO_DEG);"
        }
      ]
    },
