        "void UCharacterMovementComponent::MaybeUpdateBasedMovement(float DeltaSeconds)",
        "{",
        "\tbDeferUpdateBasedMovement = false;",
        "",
        "\tFMovementBaseInterfaceData* MovementBaseInterfaceData = GetMovementBaseInterfaceData_Mutable();",
        "\tif (MovementBaseUtility::UseRelativeLocation(MovementBaseInterfaceData))",
        "\t{",
        "\t\t// Need to see if anything we're on is simulating physics or has a parent that is.\t\t",
        "\t\tif (!MovementBaseUtility::IsSimulatedBase(MovementBaseInterfaceData))",
        "\t\t{",
        "\t\t\tbDeferUpdateBasedMovement = false;",
        "\t\t\tUpdateBasedMovement(DeltaSeconds);",
        "\t\t\t// If previously simulated, go back to using normal tick dependencies.",
        "\t\t\tif (PostPhysicsTickFunction.IsTickFunctionEnabled())",
        "\t\t\t{",
        "\t\t\t\tPostPhysicsTickFunction.SetTickFunctionEnable(false);",
        "\t\t\t\tMovementBaseUtility::AddTickDependency(PrimaryComponentTick, MovementBaseInterfaceData);",
        "\t\t\t}"
      ]
    },
