use bevy_als::extensions::{control_rig_hierarchy::{RigHierarchy,RigTransform,RigSpace},control_rig_math::RigValue,control_rig_program::RigDefinition,control_rig_units::RigUnitContext,SourceCurveValues};
use serde_json::{Value,json};
fn main(){let root=std::path::Path::new("docs/audit/bf144/476");let label=std::env::args().nth(1).unwrap();let data:Value=serde_json::from_slice(&std::fs::read(root.join("inputs.json")).unwrap()).unwrap();let definition:RigDefinition=serde_json::from_value(data["definition"].clone()).unwrap();let mut rows=Vec::new();let mut exact=0;let curves=SourceCurveValues::default();
 for r in data["current"].as_array().unwrap(){let mut hierarchy=RigHierarchy::new(definition.bones.clone(),0.0).unwrap();let before=r["bones_before"].as_array().unwrap();assert_eq!(before.len(),3);for bone in before{let index=bone[0].as_u64().unwrap()as usize;let value:RigTransform=serde_json::from_value(bone[1].clone()).unwrap();hierarchy.set_transform(index,RigSpace::Global,false,value,true).unwrap();assert_eq!(hierarchy.transform(index,RigSpace::Global,false).unwrap(),value);}
 let mut args:Vec<RigValue>=serde_json::from_value(r["arguments_before"].clone()).unwrap();let indices=args[..3].iter().map(|v|hierarchy.item_index(v).unwrap().unwrap()).collect::<Vec<_>>();let initial=indices.iter().map(|&i|hierarchy.transform(i,RigSpace::Global,true).unwrap()).collect::<Vec<_>>();let mut context=RigUnitContext{hierarchy:&mut hierarchy,curves:&curves,game_world:true,construction:false,delta_seconds:1.0/30.0,geometry:&definition.geometry,to_world:RigTransform::default(),line_trace:None};context.call("FRigUnit_TwoBoneIKSimplePerItem::Execute",&mut args).unwrap();assert_eq!(json!(&args),r["arguments_after"]);let mut after=Vec::new();for(index,original)in indices.iter().copied().zip(initial){assert_eq!(hierarchy.transform(index,RigSpace::Global,true).unwrap(),original);after.push((index,hierarchy.transform(index,RigSpace::Global,false).unwrap()));}let correct=json!(&after)==r["bones_after"];exact+=correct as usize;rows.push(json!({"mode":r["mode"],"query":r["query"],"pc":r["pc"],"before":r["bones_before"],"arguments_after":args,"after":after,"expected_after":r["bones_after"],"exact":correct}));}
 std::fs::write(root.join(format!("replay-unit-{label}.json")),serde_json::to_vec(&json!({"gate":"PUBLIC_ACTUAL_IK_SINGLE_CALL_FROM_EXACT_INPUTS","exact":exact,"rows":rows})).unwrap()).unwrap();assert_eq!(exact,1272,"All active actual leg IK public complete results");println!("Qualified1272 complete actual IK calls from exact three-bone inputs and unchanged initial definitions");}
