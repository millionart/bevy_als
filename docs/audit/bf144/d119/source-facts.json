      "anchors": [
        {
          "line": 90,
          "source": "void AAlsCharacter::StartRollingImplementation(UAnimMontage* Montage, const float PlayRate,"
        },
        {
          "line": 93,
          "source": "if (IsRollingAllowedToStart(Montage) && GetMesh()->GetAnimInstance()->Montage_Play(Montage, PlayRate) > 0.0f)"
        },
        {
          "line": 99,
          "source": "SetLocomotionAction(AlsLocomotionActionTags::Rolling);"
        }
      ]
    },
    {
      "path": "Engine/Source/Runtime/Engine/Private/Animation/AnimInstance.cpp",
      "sha256": "1becb94bac7e76eec1d84c8bd211c919e0b262f7cecd8bf3f59cd53f2309ba50",
      "anchors": [
        {
          "line": 573,
          "source": "Montage_UpdateWeight(DeltaSeconds);"
        },
        {
          "line": 578,
          "source": "Montage_Advance(DeltaSeconds);"
        },
        {
          "line": 775,
          "source": "// Update montage eval data, to be used by AnimGraph Update and Evaluate phases."
        },
        {
          "line": 2767,
          "source": "if (bStopAllMontages)"
        },
        {
          "line": 2770,
          "source": "StopAllMontagesByGroupName(NewMontageGroupName, BlendInSettings);"
        },
        {
          "line": 2804,
          "source": ""
        },
        {
          "line": 3671,
          "source": "void UAnimInstance::StopAllMontagesByGroupName(FName InGroupName, const FMontageBlendSettings& BlendOutSettings)"
        },
        {
          "line": 3682,
          "source": "FAnimMontageInstance* MontageInstance = MontageInstances[InstanceIndex];"
        },
        {
          "line": 3684,
          "source": "{"
        },
        {
          "line": 4651,
          "source": "if (MontageInstance->Montage && MontageInstance->GetWeight() > ZERO_ANIMWEIGHT_THRESH)"
        },
        {
          "line": 4659,
          "source": "MontageInstance->Montage,"
        },
        {
          "line": 4663,
          "source": "MontageInstance->IsActive(),"
        }
      ]
    },
    {
      "path": "Engine/Source/Runtime/Engine/Private/Animation/AnimMontage.cpp",
