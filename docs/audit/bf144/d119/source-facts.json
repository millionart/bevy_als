      "anchors": [
        {
          "line": 978,
          "source": "FName UAnimMontage::GetGroupName() const"
        },
        {
          "line": 983,
          "source": "return MySkeleton->GetSlotGroupName(SlotAnimTracks[0].SlotName);"
        },
        {
          "line": 1634,
          "source": "if (InBlendOutSettings.Blend.BlendTime < Blend.GetBlendTime())"
        },
        {
          "line": 1636,
          "source": "// I don't know if also using inBlendOut is better than"
        },
        {
          "line": 1639,
          "source": "Blend.SetBlendTime(InBlendOutSettings.Blend.BlendTime);"
        }
      ]
    },
    {
      "path": "Engine/Source/Runtime/Engine/Private/Animation/AnimInstanceProxy.cpp",
