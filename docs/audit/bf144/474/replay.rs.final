use bevy::math::{DQuat,DVec3};
use bevy_als::extensions::{control_rig_hierarchy::{RigHierarchy,RigTransform,RigSpace,rig_normalize},control_rig_program::RigDefinition};
use serde_json::{Value,json};
mod prior{include!("../471/replay.rs");pub fn source_normalize(v:[f64;4])->[f64;4]{normalize(v)}}
type Q=[f64;4];
fn q(v:&Value)->Q{[v["x"].as_f64().unwrap(),v["y"].as_f64().unwrap(),v["z"].as_f64().unwrap(),v["w"].as_f64().unwrap()]}
fn vec(v:&Value)->DVec3{DVec3::new(v["x"].as_f64().unwrap(),v["y"].as_f64().unwrap(),v["z"].as_f64().unwrap())}
fn project(v:Q)->Q{[-v[0],-v[2],-v[1],v[3]]}
fn vector_project(v:DVec3)->DVec3{DVec3::new(v.x,v.z,v.y)}
fn meters(v:&Value)->DVec3{if v["translation_runtime"].is_array(){DVec3::from_array(std::array::from_fn(|i|v["translation_runtime"][i].as_f64().unwrap()))}else{vector_project(vec(&v["translation"]))*0.01}}
fn transform(v:&Value)->RigTransform{RigTransform{rotation:DQuat::from_array(project(q(&v["rotation"]))),translation:meters(v),scale:vector_project(vec(&v["scale"]))}}
fn cross(a:DVec3,b:DVec3)->DVec3{DVec3::new((-a.z).mul_add(b.y,a.y*b.z),(-a.x).mul_add(b.z,a.z*b.x),(-a.y).mul_add(b.x,a.x*b.y))}
fn source(a:&Value,b:&Value,mask:u8)->Value{
 let a_q=q(&a["rotation"]);let b_q=q(&b["rotation"]);let reciprocal=vec(&b["scale"]).recip();let scale=vec(&a["scale"])*reciprocal;assert!(vec(&a["scale"]).min_element()>1e-8&&vec(&b["scale"]).min_element()>1e-8);let inverse=[-b_q[0],-b_q[1],-b_q[2],b_q[3]];
 let product=if mask&1!=0{(DQuat::from_array(inverse)*DQuat::from_array(a_q)).to_array()}else{project((DQuat::from_array(project(inverse))*DQuat::from_array(project(a_q))).to_array())};;let rotation=if mask&2!=0{prior::source_normalize(product)}else{project(rig_normalize(DQuat::from_array(project(product))).to_array())};
 let v=if mask&8!=0{vec(&a["translation"])-vec(&b["translation"])}else{vector_project(meters(a)-meters(b))};let out=if mask&4!=0{let q=DVec3::from_slice(&inverse[..3]);let c=cross(q,v);let t=c+c;let add=DVec3::new(inverse[3].mul_add(t.x,v.x),inverse[3].mul_add(t.y,v.y),inverse[3].mul_add(t.z,v.z));(add+cross(q,t))*reciprocal}else{vector_project((DQuat::from_array(project(inverse))*vector_project(v))*vector_project(reciprocal))};
 let(translation,translation_runtime)=if mask&8!=0{(out,vector_project(out)*0.01)}else{(out*100.,vector_project(out))};json!({"rotation":rotation,"translation":translation,"translation_runtime":translation_runtime,"scale":scale,"product":product})
}
fn held(v:&Value)->Value{json!({"rotation":q(&v["rotation"]),"translation":vec(&v["translation"]),"translation_runtime":meters(v),"scale":vec(&v["scale"])})}
fn model_transform(v:&Value)->RigTransform{RigTransform{rotation:DQuat::from_array(project(std::array::from_fn(|i|v["rotation"][i].as_f64().unwrap()))),translation:DVec3::from_array(std::array::from_fn(|i|v["translation_runtime"][i].as_f64().unwrap())),scale:vector_project(DVec3::from_array(std::array::from_fn(|i|v["scale"][i].as_f64().unwrap())))}}
fn exact_native(v:&Value,native:&Value)->bool{std::array::from_fn::<_,4,_>(|i|v["rotation"][i].as_f64().unwrap())==q(&native["rotation"])&&DVec3::from_array(std::array::from_fn(|i|v["translation"][i].as_f64().unwrap()))==vec(&native["translation"])&&DVec3::from_array(std::array::from_fn(|i|v["scale"][i].as_f64().unwrap()))==vec(&native["scale"])}
fn main(){
 let root=std::path::Path::new("docs/audit/bf144/474");let label=std::env::args().nth(1).unwrap();let input:Value=serde_json::from_slice(&std::fs::read(root.join("inputs.json")).unwrap()).unwrap();let def:RigDefinition=serde_json::from_value(input["definition"].clone()).unwrap();let mut outputs=Vec::new();let mut native_exact=0;let mut current_exact=0;let mut first=None;
 for row in input["source"].as_array().unwrap(){let dirty=row["local_dirty"].as_bool().unwrap();if !dirty{let mut h=RigHierarchy::new(def.bones.clone(),def.translation_tolerance).unwrap();let index=h.index(row["foot"].as_str().unwrap()).unwrap();let mut pose=def.bones.iter().map(|b|b.initial_local).collect::<Vec<_>>();pose[index]=transform(&row["before_local"]);h.set_input_pose(&pose).unwrap();assert_eq!(h.transform(index,RigSpace::Local,false).unwrap(),transform(&row["before_local"]),"Public clean local retains exact input without global roundtrip");}
  for mask in 0..16{let stages=source(&row["global_transform"],&row["parent_global"],mask);let out=if dirty{stages.clone()}else{held(&row["before_local"])};let exact=exact_native(&out,&row["native_local"]);if mask==15{native_exact+=exact as usize;if !exact&&first.is_none(){first=Some(json!({"input":row,"stages":stages,"result":out}));}}if mask==0{let public=transform(&row["global_transform"]).relative(transform(&row["parent_global"]));assert_eq!(public,model_transform(&stages),"Qualified current relative model on common inputs");}outputs.push(json!({"dataset":row["dataset"],"case":row["case"],"query":row["query"],"foot":row["foot"],"local_dirty":dirty,"mask":mask,"stages":stages,"result":out,"native":row["native_local"],"exact":exact}));}}
 let mut actual=Vec::new();let mut matrix=Vec::new();let mut source_endpoint=0;
 for row in input["actual"].as_array().unwrap(){assert_eq!(row["source"]["local_dirty"],true);let a:RigTransform=serde_json::from_value(row["global_transform"].clone()).unwrap();let b:RigTransform=serde_json::from_value(row["parent_global"].clone()).unwrap();let expected:RigTransform=serde_json::from_value(row["expected_local"].clone()).unwrap();let current=a.relative(b);assert_eq!(current,expected,"Exact actual current foot local");current_exact+=1;actual.push(json!({"mode":row["mode"],"query":row["query"],"foot":row["foot"],"result":current,"expected":expected}));let native=transform(&row["source"]["native_local"]);
  for data_mask in 0..4{let a=if data_mask&1!=0{&row["source"]["global_transform"]}else{&row["current_global_source_axes"]};let b=if data_mask&2!=0{&row["source"]["parent_global"]}else{&row["current_parent_source_axes"]};for mask in 0..16{let stages=source(a,b,mask);let result=model_transform(&stages);if mask==0{assert_eq!(result,transform(a).relative(transform(b)),"Exact public relative in all actual/mixed domains");if data_mask==0{assert_eq!(result,current);}}if data_mask==3&&mask==15{assert_eq!(result,native);source_endpoint+=1;}matrix.push(json!({"mode":row["mode"],"query":row["query"],"foot":row["foot"],"data_mask":data_mask,"math_mask":mask,"stages":stages,"result":result,"native":native,"exact":result==native}));}}
 }
 std::fs::write(root.join(format!("replay-{label}.json")),serde_json::to_vec(&json!({"gate":"SOURCE_FOOT_GLOBAL_TO_LOCAL_NATIVE_CACHE_AND_ACTUAL_PUBLIC_FACTORS","source_exact":native_exact,"current_actual_exact":current_exact,"source_endpoint_exact":source_endpoint,"first":first,"outputs":outputs,"actual":actual,"matrix":matrix})).unwrap()).unwrap();assert_eq!(native_exact,696,"Complete source foot global-to-local with actual dirty flag");assert_eq!(current_exact,1272);assert_eq!(source_endpoint,1272);println!("Qualified696 source local branches,1272 actual current locals and81408 data/math records");
}
