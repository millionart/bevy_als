  "path": "Source/ALS/Private/AlsCharacter.cpp",
  "sha256": "779192e94d0a1ac13ccf95cfa9db540cc4f6230a2dc3ab9113848f8d983ace84",
  "first_line": 504,
  "lines": [
    "",
    "void AAlsCharacter::NotifyLocomotionModeChanged(const FGameplayTag PreviousLocomotionMode)",
    "{",
    "\tApplyDesiredStance();",
    "",
    "\tif (LocomotionMode == AlsLocomotionModeTags::Grounded &&",
    "\t    PreviousLocomotionMode == AlsLocomotionModeTags::InAir)",
    "\t{",
    "\t\tif (Settings->Ragdolling.bStartRagdollingOnLand &&",
    "\t\t    LocomotionState.Velocity.Z <= -Settings->Ragdolling.RagdollingOnLandSpeedThreshold)",
    "\t\t{",
    "\t\t\tStartRagdolling();",
    "\t\t}",
    "\t\telse if (Settings->Rolling.bStartRollingOnLand &&",
    "\t\t         LocomotionState.Velocity.Z <= -Settings->Rolling.RollingOnLandSpeedThreshold)",
    "\t\t{",
    "\t\t\tstatic constexpr auto PlayRate{1.3f};",
    "",
    "\t\t\tStartRolling(LocomotionState.bHasVelocity",
    "\t\t\t\t             ? LocomotionState.VelocityYawAngle",
    "\t\t\t\t             : UE_REAL_TO_FLOAT(FMath::UnwindDegrees(GetActorRotation().Yaw)),",
    "\t\t\t             PlayRate);",
    "\t\t}",
    "\t\telse",
    "\t\t{",
    "\t\t\t// Increase friction for a short period of time to prevent sliding on the ground after landing.",
    "",
    "\t\t\tstatic constexpr auto HasInputBrakingFrictionFactor{0.5f};",
    "\t\t\tstatic constexpr auto NoInputBrakingFrictionFactor{3.0f};",
    "",
    "\t\t\tGetCharacterMovement()->BrakingFrictionFactor = LocomotionState.bHasInput",
    "\t\t\t\t                                                ? HasInputBrakingFrictionFactor",
    "\t\t\t\t                                                : NoInputBrakingFrictionFactor;",
    "",
    "\t\t\tstatic constexpr auto ResetDelay{0.5f};",
    "",
    "\t\t\tGetWorldTimerManager().SetTimer(BrakingFrictionFactorResetTimer,",
    "\t\t\t                                FTimerDelegate::CreateWeakLambda(this, [this]",
    "\t\t\t                                {",
    "\t\t\t\t                                GetCharacterMovement()->BrakingFrictionFactor = 0.0f;",
    "\t\t\t                                }), ResetDelay, false);",
    "",
    "\t\t\t// Block rotation towards the last input direction after landing to prevent",
    "\t\t\t// legs from twisting into a spiral while the landing animation is playing.",
    "",
    "\t\t\tLocomotionState.bRotationTowardsLastInputDirectionBlocked = true;"
  ]
}
