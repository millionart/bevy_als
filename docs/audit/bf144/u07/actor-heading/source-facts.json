        "lines": [
          "\tconst auto& Proxy{GetProxyOnGameThread<FAnimInstanceProxy>()};",
          "\tconst auto& ActorTransform{Proxy.GetActorTransform()};",
          "\tconst auto& ComponentTransformActorSpace{Proxy.GetComponentRelativeTransform()};",
          "",
          "\tstatic const auto* EnableListenServerSmoothingConsoleVariable{",
          "\t\tIConsoleManager::Get().FindConsoleVariable(TEXT(\"p.NetEnableListenServerSmoothing\"))",
          "\t};",
          "\tcheck(EnableListenServerSmoothingConsoleVariable != nullptr)",
          "",
          "\tconst auto* Mesh{GetSkelMeshComponent()};",
          "",
          "\tif (Movement->NetworkSmoothingMode == ENetworkSmoothingMode::Disabled ||",
          "\t    (Character->GetLocalRole() != ROLE_SimulatedProxy &&",
          "\t     !(Character->IsNetMode(NM_ListenServer) && EnableListenServerSmoothingConsoleVariable->GetBool())))",
          "\t{",
          "\t\t// If the network smoothing is disabled, use the regular actor transform.",
          "",
          "\t\tLocomotionState.LocationWorldSpace = ActorTransform.GetLocation();",
          "\t\tLocomotionState.RotationWorldSpace = ActorTransform.Rotator();",
          "\t\tLocomotionState.RotationQuaternionWorldSpace = ActorTransform.GetRotation();",
          "\t}"
        ]
      }
    ]
  },
