        "first_line": 1904,
        "lines": [
          "void AAlsCharacter::SetRotationExtraSmooth(const float TargetYawAngle, const float DeltaTime,",
          "                                           const float InterpolationHalfLife, const float TargetYawAngleRotationSpeed)",
          "{",
          "\tSetTargetYawAngleSmooth(TargetYawAngle, DeltaTime, TargetYawAngleRotationSpeed);",
          "",
          "\tauto NewRotation{GetActorRotation()};",
          "\tNewRotation.Yaw = UAlsRotation::DamperExactAngle(UE_REAL_TO_FLOAT(FMath::UnwindDegrees(NewRotation.Yaw)),",
          "\t                                                 LocomotionState.SmoothTargetYawAngle, DeltaTime, InterpolationHalfLife);",
          "",
          "\tSetActorRotation(NewRotation);",
          "}"
        ]
      }
    ]
  },
  {
    "source": "UE",
    "path": "Engine/Source/Runtime/Engine/Private/Animation/AnimInstanceProxy.cpp",
    "sha256": "05bbce3b799bcb42df19528c8f014eadea728e922382fffda1bb074d0e4a40b1",
    "excerpts": [
      {
        "first_line": 1411,
        "lines": [
          "\t// When playing root motion is the CharacterMovementComp who triggers the animation update and this happens before root motion is consumed and the position of the character is updated for this frame",
          "\t// which means that at the point ComponentTransform is cached in the PreUpdate function it contain the previous frame transform",
          "\tif (SkeletalMeshComponent && SkeletalMeshComponent->IsPlayingRootMotion())",
          "\t{",
          "\t\tComponentTransform = SkeletalMeshComponent->GetComponentTransform();",
          "\t\tComponentRelativeTransform = SkeletalMeshComponent->GetRelativeTransform();",
          "\t\tActorTransform = SkeletalMeshComponent->GetOwner() ? SkeletalMeshComponent->GetOwner()->GetActorTransform() : FTransform::Identity;",
          "\t}",
          "",
          "#if ENABLE_ANIM_LOGGING"
        ]
      }
    ]
  },
