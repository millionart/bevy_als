    "UE/CharacterMovementComponent.cpp": {
      "sha256": "017d191be669dd10c70da577e42394387554880c86e5736caeb9134df6ff8136",
      "excerpts": [
        {
          "start_line": 6412,
          "lines": [
            "void UCharacterMovementComponent::SetPostLandedPhysics(const FHitResult& Hit)",
            "{",
            "\tif( CharacterOwner )",
            "\t{",
            "\t\tif (CanEverSwim() && IsInWater())",
            "\t\t{",
            "\t\t\tSetMovementMode(MOVE_Swimming);",
            "\t\t}",
            "\t\telse",
            "\t\t{",
            "\t\t\tconst FVector PreImpactAccel = Acceleration + (IsFalling() ? -GetGravityDirection() * GetGravityZ() : FVector::ZeroVector);",
            "\t\t\tconst FVector PreImpactVelocity = Velocity;",
            "",
            "\t\t\tif (DefaultLandMovementMode == MOVE_Walking ||",
            "\t\t\t\tDefaultLandMovementMode == MOVE_NavWalking ||",
            "\t\t\t\tDefaultLandMovementMode == MOVE_Falling)",
            "\t\t\t{",
            "\t\t\t\tSetMovementMode(GroundMovementMode);",
            "\t\t\t}",
            "\t\t\telse",
            "\t\t\t{",
            "\t\t\t\tSetDefaultMovementMode();",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tApplyImpactPhysicsForces(Hit, PreImpactAccel, PreImpactVelocity);",
            "\t\t}",
            "\t}",
            "}"
          ]
        },
        {
          "start_line": 7445,
          "lines": [
            "float UCharacterMovementComponent::GetPerchRadiusThreshold() const",
            "{",
            "\t// Don't allow negative values.",
            "\treturn FMath::Max(0.f, PerchRadiusThreshold);",
            "}",
            "",
            "",
            "float UCharacterMovementComponent::GetValidPerchRadius() const",
            "{",
            "\tif (CharacterOwner)",
            "\t{",
            "\t\tconst float PawnRadius = CharacterOwner->GetCapsuleComponent()->GetScaledCapsuleRadius();",
            "\t\treturn FMath::Clamp(PawnRadius - GetPerchRadiusThreshold(), 0.11f, PawnRadius);",
            "\t}",
            "\treturn 0.f;"
          ]
        }
      ]
    },
