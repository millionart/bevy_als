        {
          "start_line": 120,
          "lines": [
            "void AAlsCharacter::PostInitializeComponents()",
            "{",
            "\t// Make sure the mesh and animation blueprint are ticking after the character so they can access the most up-to-date character state.",
            "",
            "\tGetMesh()->AddTickPrerequisiteActor(this);",
            "",
            "\tAlsCharacterMovement->OnPhysicsRotation.AddUObject(this, &ThisClass::CharacterMovement_OnPhysicsRotation);",
            "",
            "\t// Pass current movement settings to the movement component.",
            "",
            "\tAlsCharacterMovement->SetMovementSettings(MovementSettings);",
            "",
            "\tAnimationInstance = Cast<UAlsAnimationInstance>(GetMesh()->GetAnimInstance());",
            "",
            "\tSuper::PostInitializeComponents();",
            "}"
          ]
        }
      ]
    },
    "Source/ALS/Private/AlsAnimationInstance.cpp": {
      "sha256": "4e6b524c067065c5597aff680584b267eb12e7625241da59342d544c6f33f24c",
      "sections": [
        {
          "start_line": 29,
          "lines": [
            "void UAlsAnimationInstance::NativeInitializeAnimation()",
            "{",
            "\tSuper::NativeInitializeAnimation();",
            "",
            "\tCharacter = Cast<AAlsCharacter>(GetOwningActor());",
            "",
            "#if WITH_EDITOR",
            "\tconst auto* World{GetWorld()};",
            "",
            "\tif (IsValid(World) && !World->IsGameWorld() && !IsValid(Character))",
            "\t{",
            "\t\t// Use default objects for editor preview.",
            "\t\tCharacter = GetMutableDefault<AAlsCharacter>();",
            "\t}",
            "#endif",
            "",
            "\tconst auto* Mesh{GetSkelMeshComponent()};"
          ]
        },
        {
          "start_line": 98,
          "lines": [
            "void UAlsAnimationInstance::NativeUpdateAnimation(const float DeltaTime)",
            "{",
            "\tDECLARE_SCOPE_CYCLE_COUNTER(TEXT(\"UAlsAnimationInstance::NativeUpdateAnimation\"),",
            "\t                            STAT_UAlsAnimationInstance_NativeUpdateAnimation, STATGROUP_Als)",
            "\tTRACE_CPUPROFILER_EVENT_SCOPE_STR(__FUNCTION__)",
            "",
            "\tSuper::NativeUpdateAnimation(DeltaTime);",
            "",
            "\tif (!IsValid(Settings) || !IsValid(Character))",
            "\t{",
            "\t\treturn;",
            "\t}"
          ]
        },
        {
          "start_line": 140,
          "lines": [
            "\tViewMode = Character->GetViewMode();",
            "\tLocomotionMode = Character->GetLocomotionMode();",
            "\tRotationMode = Character->GetRotationMode();",
            "\tStance = Character->GetStance();",
            "\tGait = Character->GetGait();",
            "\tOverlayMode = Character->GetOverlayMode();",
            "",
            "\tif (LocomotionAction != Character->GetLocomotionAction())",
            "\t{",
            "\t\tLocomotionAction = Character->GetLocomotionAction();",
            "\t\tResetGroundedEntryMode();",
            "\t}",
            "",
            "\tconst auto PreviousLocation{LocomotionState.LocationWorldSpace};",
            "",
            "\tRefreshMovementBaseOnGameThread();",
            "\tRefreshViewOnGameThread();",
            "\tRefreshLocomotionOnGameThread();",
            "\tRefreshInAirOnGameThread();",
            "\tRefreshFeetOnGameThread();",
            "\tRefreshRagdollingOnGameThread();"
          ]
        }
      ]
    },
    "Source/ALS/Private/AlsLinkedAnimationInstance.cpp": {
      "sha256": "1ac10233195b489e6ad6abdb151511a29318eea9696a8087f2fda4e3c8fb4d6a",
      "sections": [
        {
          "start_line": 98,
          "lines": [
            "void UAlsLinkedAnimationInstance::ResetGroundedEntryMode()",
            "{",
            "\tif (Parent.IsValid())",
            "\t{",
            "\t\tParent->ResetGroundedEntryMode();",
            "\t}",
            "}"
          ]
        }
      ]
    }
  },
  "character_mesh": {
    "SkeletalMeshAsset": "/Script/Engine.SkeletalMesh'/ALS/ALS/Character/SKM_Als.SKM_Als'",
    "AnimClass": "/Script/Engine.AnimBlueprintGeneratedClass'/ALS/ALS/Character/AB_Als.AB_Als_C'",
    "AnimationMode": "AnimationBlueprint"
  },
  "consumer": "AB_Als NativeUpdateAnimation compares the locomotion action on the current instance, then publishes GroundedEntryMode to the linked Grounded graph. The linked instance delegates ResetGroundedEntryMode to its parent."
}
