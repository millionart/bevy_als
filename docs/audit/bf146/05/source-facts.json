        {
          "start_line": 222,
          "lines": [
            "void UAlsCharacterMovementComponent::SetMovementMode(const EMovementMode NewMovementMode, const uint8 NewCustomMode)",
            "{",
            "\tif (!bMovementModeLocked)",
            "\t{",
            "\t\tSuper::SetMovementMode(NewMovementMode, NewCustomMode);",
            "\t}",
            "}",
            "",
            "void UAlsCharacterMovementComponent::OnMovementModeChanged(const EMovementMode PreviousMovementMode, const uint8 PreviousCustomMode)",
            "{",
            "\tSuper::OnMovementModeChanged(PreviousMovementMode, PreviousCustomMode);",
            "",
            "\t// This removes some very noticeable changes in the mesh location when the",
            "\t// character automatically uncrouches at the end of the roll in the air.",
            "",
            "\tbCrouchMaintainsBaseLocation = true;",
            "}"
          ]
        }
      ]
    },
    "UE/CharacterMovementComponent.cpp": {
      "sha256": "017d191be669dd10c70da577e42394387554880c86e5736caeb9134df6ff8136",
      "excerpts": [
        {
          "start_line": 1158,
          "lines": [
            "\t\t\t// Checking JumpCurrentCountPreJump instead of JumpCurrentCount because Character::CheckJumpInput might have",
            "\t\t\t// incremented JumpCurrentCount just before entering this function... in order to compensate for the case when",
            "\t\t\t// on the first frame of the jump, we're already in falling stage. So we want the original value before any ",
            "\t\t\t// modification here.",
            "\t\t\t// ",
            "\t\t\tconst bool bFirstJump = (CharacterOwner->JumpCurrentCountPreJump == 0);",
            "",
            "\t\t\tif (bFirstJump || bDontFallBelowJumpZVelocityDuringJump)",
            "\t\t\t{",
            "\t\t\t\tif (HasCustomGravity())",
            "\t\t\t\t{",
            "\t\t\t\t\tSetGravitySpaceZ(Velocity, FMath::Max<FVector::FReal>(GetGravitySpaceZ(Velocity), JumpZVelocity));",
            "\t\t\t\t}",
            "\t\t\t\telse",
            "\t\t\t\t{",
            "\t\t\t\t\tVelocity.Z = FMath::Max<FVector::FReal>(Velocity.Z, JumpZVelocity);",
            "\t\t\t\t}",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tSetMovementMode(MOVE_Falling);",
            "\t\t\treturn true;",
            "\t\t}",
            "\t}",
            "\t",
            "\treturn false;"
          ]
        },
        {
          "start_line": 1360,
          "lines": [
            "void UCharacterMovementComponent::SetMovementMode(EMovementMode NewMovementMode, uint8 NewCustomMode)",
            "{",
            "\tif (NewMovementMode != MOVE_Custom)",
            "\t{",
            "\t\tNewCustomMode = 0;",
            "\t}",
            "",
            "\t// If trying to use NavWalking but there is no navmesh, use walking instead.",
            "\tif (NewMovementMode == MOVE_NavWalking)",
            "\t{",
            "\t\tif (GetNavData() == nullptr)",
            "\t\t{",
            "\t\t\tNewMovementMode = MOVE_Walking;",
            "\t\t}",
            "\t}",
            "",
            "\t// Do nothing if nothing is changing.",
            "\tif (MovementMode == NewMovementMode)",
            "\t{",
            "\t\t// Allow changes in custom sub-mode.",
            "\t\tif ((NewMovementMode != MOVE_Custom) || (NewCustomMode == CustomMovementMode))",
            "\t\t{",
            "\t\t\treturn;",
            "\t\t}",
            "\t}",
            "",
            "\tconst EMovementMode PrevMovementMode = MovementMode;",
            "\tconst uint8 PrevCustomMode = CustomMovementMode;",
            "",
            "\tMovementMode = NewMovementMode;",
            "\tCustomMovementMode = NewCustomMode;",
            "",
            "\t// We allow setting movement mode before we have a component to update, in case this happens at startup.",
            "\tif (!HasValidData())",
            "\t{",
            "\t\treturn;",
            "\t}",
            "\t",
            "\t// Handle change in movement mode",
            "\tOnMovementModeChanged(PrevMovementMode, PrevCustomMode);",
            "",
            "\t// @todo do we need to disable ragdoll physics here? Should this function do nothing if in ragdoll?",
            "",
            "\tbMovementModeDirty = true; // lets async callback know movement mode was dirtied on game thread",
            "}",
            "",
            "",
            "void UCharacterMovementComponent::OnMovementModeChanged(EMovementMode PreviousMovementMode, uint8 PreviousCustomMode)"
          ]
        },
        {
          "start_line": 6373,
          "lines": [
            "void UCharacterMovementComponent::ProcessLanded(const FHitResult& Hit, float remainingTime, int32 Iterations)",
            "{",
            "\tSCOPE_CYCLE_COUNTER(STAT_CharProcessLanded);",
            "",
            "\tif( CharacterOwner && CharacterOwner->ShouldNotifyLanded(Hit) )",
            "\t{",
            "\t\tCharacterOwner->Landed(Hit);",
            "\t}",
            "\tif( IsFalling() )"
          ]
        },
        {
          "start_line": 6400,
          "lines": [
            "\t\tSetPostLandedPhysics(Hit);",
            "\t}",
            "\t",
            "\tIPathFollowingAgentInterface* PFAgent = GetPathFollowingAgent();",
            "\tif (PFAgent)",
            "\t{",
            "\t\tPFAgent->OnLanded();",
            "\t}",
            "",
            "\tStartNewPhysics(remainingTime, Iterations);",
            "}",
            "",
            "void UCharacterMovementComponent::SetPostLandedPhysics(const FHitResult& Hit)",
            "{",
            "\tif( CharacterOwner )",
            "\t{",
            "\t\tif (CanEverSwim() && IsInWater())",
            "\t\t{",
            "\t\t\tSetMovementMode(MOVE_Swimming);",
            "\t\t}",
            "\t\telse",
            "\t\t{",
            "\t\t\tconst FVector PreImpactAccel = Acceleration + (IsFalling() ? -GetGravityDirection() * GetGravityZ() : FVector::ZeroVector);",
            "\t\t\tconst FVector PreImpactVelocity = Velocity;",
            "",
            "\t\t\tif (DefaultLandMovementMode == MOVE_Walking ||",
            "\t\t\t\tDefaultLandMovementMode == MOVE_NavWalking ||",
            "\t\t\t\tDefaultLandMovementMode == MOVE_Falling)",
            "\t\t\t{",
            "\t\t\t\tSetMovementMode(GroundMovementMode);",
            "\t\t\t}",
            "\t\t\telse",
            "\t\t\t{",
            "\t\t\t\tSetDefaultMovementMode();",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tApplyImpactPhysicsForces(Hit, PreImpactAccel, PreImpactVelocity);"
          ]
        }
      ]
    }
