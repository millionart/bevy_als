          "lines": [
            "void AAlsCharacter::OnMovementModeChanged(const EMovementMode PreviousMovementMode, const uint8 PreviousCustomMode)",
            "{",
            "\t// Use the character movement mode to set the locomotion mode to the right value. This allows you to have a",
            "\t// custom set of movement modes but still use the functionality of the default character movement component.",
            "",
            "\tswitch (GetCharacterMovement()->MovementMode) // NOLINT(clang-diagnostic-switch-enum)",
            "\t{",
            "\t\tcase MOVE_Walking:",
            "\t\tcase MOVE_NavWalking:",
            "\t\t\tSetLocomotionMode(AlsLocomotionModeTags::Grounded);",
            "\t\t\tbreak;",
            "",
            "\t\tcase MOVE_Falling:",
            "\t\t\tSetLocomotionMode(AlsLocomotionModeTags::InAir);",
            "\t\t\tbreak;",
            "",
            "\t\tdefault:",
            "\t\t\tSetLocomotionMode(FGameplayTag::EmptyTag);",
            "\t\t\tbreak;",
            "\t}",
            "",
            "\tSuper::OnMovementModeChanged(PreviousMovementMode, PreviousCustomMode);",
            "}",
            "",
            "void AAlsCharacter::SetLocomotionMode(const FGameplayTag NewLocomotionMode)",
            "{",
            "\tif (LocomotionMode != NewLocomotionMode)",
            "\t{",
            "\t\tconst auto PreviousLocomotionMode{LocomotionMode};",
            "",
            "\t\tLocomotionMode = NewLocomotionMode;",
            "",
            "\t\tNotifyLocomotionModeChanged(PreviousLocomotionMode);",
            "\t}",
            "}"
          ]
        }
      ]
    },
    "ALS/AlsCharacter_Actions.cpp": {
      "sha256": "3dbd91f26154fd99297a7c7bb293993d938a86b8937d7071760cabc8517aa317",
      "excerpts": [
        {
          "start_line": 494,
          "lines": [
            "\t// Clear the character movement mode and set the locomotion action to mantling.",
            "",
            "\tGetCharacterMovement()->SetMovementMode(MOVE_Custom);",
            "\tAlsCharacterMovement->SetMovementModeLocked(true);",
            "",
            "\tFMovementBaseInterfaceData MovementBaseData{Parameters.TargetPrimitive.Get()};",
            "\tGetCharacterMovement()->SetBase(&MovementBaseData);",
            "",
            "\t// Create mantling root motion."
          ]
        },
        {
          "start_line": 698,
          "lines": [
            "\tMantlingState.RootMotionSourceId = 0;",
            "",
            "\tif (bStopMontage && RootMotionSource != nullptr)",
            "\t{",
            "\t\tGetMesh()->GetAnimInstance()->Montage_Stop(Settings->Mantling.BlendOutDuration, RootMotionSource->MantlingSettings->Montage);",
            "\t}",
            "",
            "\tGetCharacterMovement()->NetworkSmoothingMode = ENetworkSmoothingMode::Exponential;",
            "",
            "\tAlsCharacterMovement->SetMovementModeLocked(false);",
            "\tGetCharacterMovement()->SetMovementMode(MOVE_Walking);",
            "",
            "\tOnMantlingEnded();"
          ]
        },
        {
          "start_line": 836,
          "lines": [
            "\t// Clear the character movement mode and set the locomotion action to ragdolling.",
            "",
            "\tGetCharacterMovement()->SetMovementMode(MOVE_None);",
            "\tAlsCharacterMovement->SetMovementModeLocked(true);",
            "",
            "\tSetLocomotionAction(AlsLocomotionActionTags::Ragdolling);",
            "",
            "\tOnRagdollingStarted();"
          ]
        },
        {
          "start_line": 1140,
          "lines": [
            "\t// If the ragdoll is on the ground, set the movement mode to walking and play a get up montage. If not, set",
            "\t// the movement mode to falling and update the character movement velocity to match the last ragdoll velocity.",
            "",
            "\tAlsCharacterMovement->SetMovementModeLocked(false);",
            "",
            "\tif (bGrounded)",
            "\t{",
            "\t\tGetCharacterMovement()->SetMovementMode(MOVE_Walking);",
            "\t}",
            "\telse",
            "\t{",
            "\t\tGetCharacterMovement()->SetMovementMode(MOVE_Falling);",
            "\t\tGetCharacterMovement()->Velocity = RagdollingState.Velocity;",
            "\t}",
            "",
            "\tSetLocomotionAction(FGameplayTag::EmptyTag);",
            "",
            "\tOnRagdollingEnded();",
            "",
            "\tif (bGrounded && GetMesh()->GetAnimInstance()->Montage_Play(SelectGetUpMontage(bRagdollFacingUpward)) > 0.0f)",
            "\t{",
            "\t\tAlsCharacterMovement->SetInputBlocked(true);",
            "",
            "\t\tSetLocomotionAction(AlsLocomotionActionTags::GettingUp);",
            "\t}"
          ]
        }
      ]
    },
    "ALS/AlsCharacterMovementComponent.cpp": {
