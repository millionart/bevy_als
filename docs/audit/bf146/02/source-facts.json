            "void AAlsCharacter::RefreshGait()",
            "{",
            "\tif (LocomotionMode != AlsLocomotionModeTags::Grounded)",
            "\t{",
            "\t\treturn;",
            "\t}",
            "",
            "\tconst auto MaxAllowedGait{CalculateMaxAllowedGait()};",
            "",
            "\t// Update the character max walk speed to the configured speeds based on the currently max allowed gait.",
            "",
            "\tAlsCharacterMovement->SetMaxAllowedGait(MaxAllowedGait);",
            "",
            "\tconst auto ActualGait{CalculateActualGait(MaxAllowedGait)};",
            "",
            "\tSetGait(ActualGait);",
            "}"
          ]
        }
